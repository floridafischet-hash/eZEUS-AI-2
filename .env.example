APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_LOG_LEVEL=INFO
FORWARDED_ALLOW_IPS=127.0.0.1

# Datenbankpasswort — Settings erzeugt daraus sicher die interne Verbindungs-URL
POSTGRES_PASSWORD=example-postgres-password-change-me

REDIS_URL=redis://redis:6379/0
PAPERLESS_BASE_URL=http://paperless:8000
PAPERLESS_API_TOKEN=example-paperless-api-token
PAPERLESS_WEBHOOK_SECRET=example-webhook-secret
PROXY_AUTH_SECRET=
CREDENTIAL_ENCRYPTION_KEY=example-fernet-key
PUBLIC_WEBHOOK_BASE_URL=
PAPERLESS_VERIFY_TLS=true
LOCAL_ONLY=true
CLOUD_AI_GLOBALLY_ALLOWED=false
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_MAX_INPUT_CHARS=24000
OLLAMA_MAX_RESPONSE_BYTES=1048576
OLLAMA_KEEP_ALIVE=10m
JOB_MAX_RETRIES=3
JOB_RETRY_DELAYS_SECONDS=30,120,600
CELERY_CONCURRENCY=2
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30
RATE_LIMIT_MAX_CLIENTS=10000
RATE_LIMIT_TRUST_PROXY_HEADERS=false
OUTBOUND_ALLOWED_HOSTS=
OUTBOUND_PRIVATE_ALLOWED_HOSTS=
OUTBOUND_BLOCK_PRIVATE_NETWORKS=true
PAPERLESS_MAX_DOWNLOAD_BYTES=52428800
PAPERLESS_MAX_TEXT_CHARS=2000000
ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,image/png,image/jpeg,image/tiff,image/webp,text/plain
REGEX_HARD_TIMEOUT_SECONDS=2
OUTBOX_POLL_SECONDS=1
OUTBOX_CLAIM_TIMEOUT_SECONDS=300
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_BACKOFF_SECONDS=300
