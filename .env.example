APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_LOG_LEVEL=INFO
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://ezeus:example-postgres-password-change-me@postgres:5432/ezeus
REDIS_URL=redis://redis:6379/0
PAPERLESS_BASE_URL=http://paperless:8000
PAPERLESS_API_TOKEN=change-me
PAPERLESS_WEBHOOK_SECRET=change-me
ADMIN_API_SECRET=change-me
PAPERLESS_VERIFY_TLS=true
LOCAL_ONLY=true
CLOUD_AI_GLOBALLY_ALLOWED=false
JOB_MAX_RETRIES=3
JOB_RETRY_DELAYS_SECONDS=30,120,600

OCR_PROVIDER=paddleocr
OCR_LANGUAGE=de
OCR_DEVICE=cpu
OCR_TIMEOUT_SECONDS=300
MAX_DOCUMENT_BYTES=104857600
