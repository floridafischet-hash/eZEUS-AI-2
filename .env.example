APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_LOG_LEVEL=INFO

# Datenbankpasswort — wird von docker-compose zu DATABASE_URL zusammengebaut
POSTGRES_PASSWORD=example-postgres-password-change-me

REDIS_URL=redis://redis:6379/0
PAPERLESS_BASE_URL=http://paperless:8000
PAPERLESS_API_TOKEN=example-paperless-api-token
PAPERLESS_WEBHOOK_SECRET=example-webhook-secret
PROXY_AUTH_SECRET=
CREDENTIAL_ENCRYPTION_KEY=example-fernet-key
PUBLIC_WEBHOOK_BASE_URL=
PAPERLESS_VERIFY_TLS=true
LOCAL_ONLY=true
CLOUD_AI_GLOBALLY_ALLOWED=false
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_MAX_INPUT_CHARS=24000
OLLAMA_KEEP_ALIVE=10m
JOB_MAX_RETRIES=3
JOB_RETRY_DELAYS_SECONDS=30,120,600
